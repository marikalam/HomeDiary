# Postgres connection string (Neon, or any Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=4000

# Long random string used to sign login sessions
JWT_SECRET="change-me-to-a-long-random-string"

# In production, set to your deployed frontend URL if it's served from a
# different origin than the API. Leave unset for local dev / single-service deploys.
CLIENT_ORIGIN=

# Cloudflare R2 (S3-compatible) file storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=homediary-uploads

# Google Calendar linking (optional - the "Connect Google Calendar" button
# only appears if these are set). Create credentials at
# https://console.cloud.google.com/apis/credentials - see DEPLOY.md for
# the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client, and
# point at this server: http://localhost:4000/api/google/callback for
# local dev, https://<your-deployed-url>/api/google/callback in production.
GOOGLE_REDIRECT_URI=
